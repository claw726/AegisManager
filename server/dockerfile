# Build stage
FROM gradle:jdk-lts-and-current-alpine AS build

WORKDIR /app

# Cache gradle files
COPY --chown=gradle:gradle gradle/ gradle/
COPY --chown=gradle:gradle build.gradle ./

# Optimize Gradle
ENV GRADLE_OPTS="-Dorg.gradle.daemon=false \
    -Dorg.gradle.parallel=true \
    -Dorg.gradle.caching=true \
    -Dorg.gradle.configureondemand=true \
    -Dorg.gradle.jvmargs=-Xmx2048m"


# Download dependencies (this layer will be cached)
RUN gradle dependencies --no-daemon

# Copy source code
COPY --chown=gradle:gradle src ./src

# Build the project
RUN gradle clean build -x test --no-daemon

# Runtime stage
FROM eclipse-temurin:23-jre-alpine

WORKDIR /app


# Install security updates and add necessary packages
RUN apk update && \
    apk upgrade && \
    apk add --no-cache tini curl openssl && \
    mkdir -p /app/data && \
    addgroup -S spring && \
    adduser -S spring -G spring && \
    chown -R spring:spring /app && \
    chmod -R 755 /app && \
    rm -rf /var/cache/apk/*

# Generate keystore
RUN keytool -genkeypair \
    -alias tomcat \
    -keyalg RSA \
    -keysize 2048 \
    -keystore /app/keystore.p12 \
    -validity 3650 \
    -storetype PKCS12 \
    -storepass changeit \
    -keypass changeit \
    -dname "CN=AegisManager, OU=Aegis, O=Purdue, L=WestLafayette, S=IN, C=US"

# Set ownership of the keystore
RUN chown spring:spring /app/keystore.p12


# Use tini as init process
ENTRYPOINT ["/sbin/tini", "--"]

# Set ownership to the non-root user
USER spring:spring

# Copy only the JAR file from build stage
COPY --from=build --chown=spring:spring /app/build/libs/*.jar app.jar

# Copy only the templates directory
COPY --chown=gradle:gradle src/main/resources/templates ./src/main/resources/templates

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=3s \
  CMD curl -k --fail https://localhost:8444/actuator/health || exit 1

EXPOSE 8444

# Optimize Java runtime
CMD ["java", \
    "-XX:+UseContainerSupport", \
    "-XX:MaxRAMPercentage=75", \
    "-XX:InitialRAMPercentage=50", \
    "-XX:+UseG1GC", \
    "-XX:+HeapDumpOnOutOfMemoryError", \
    "-XX:HeapDumpPath=/app/data/heap-dump.hprof", \
    "-XX:+UseStringDeduplication", \
    "-Djava.security.egd=file:/dev/./urandom", \
    "-Dserver.ssl.key-store=/app/keystore.p12", \
    "-Dserver.ssl.key-store-password=changeit", \
    "-Dserver.ssl.key-alias=tomcat", \
    "-Dserver.ssl.key-store-type=PKCS12", \
    "-Dserver.port=8444", \
    "-jar", \
    "app.jar" \
]