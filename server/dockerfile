FROM gradle:8.10.1-jdk17 AS build

# Set environment variables
ENV SPRING_OUTPUT_ANSI_ENABLED=ALWAYS \
    SPRING_APPLICATION_JSON="{\"server\":{\"ssl\":{\"enabled\":true,\"key-store\":\"classpath:keystore.p12\",\"key-store-password\":\"AegisPassword\",\"key-alias\":\"aegis\"}}}"

# Copy the Gradle Wrapper
COPY gradlew /app/
COPY gradle /app/gradle

# Copy the project source
COPY . /app/

# Change working directory
WORKDIR /app

# Build the project
RUN ./gradlew build --no-daemon || return 0

# Create a new stage for the runtime environment
FROM eclipse-temurin:17

# Set environment variables
ENV SPRING_OUTPUT_ANSI_ENABLED=ALWAYS \
    SPRING_APPLICATION_JSON='{"server":{"ssl":{"enabled":true,"key-store":"classpath:keystore.p12","key-store-password":"AegisPassword","key-alias":"aegis"}}}'

# Copy the keystore.p12 from resources
COPY ./src/main/resources/keystore.p12 /app/

# Copy the compiled JAR file to the production image
COPY --from=build /app/build/libs/*.jar /app/app.jar

# Copy the DB
COPY db/aegis.db /app/

# Export the port
EXPOSE 8443

# Run the application
CMD ["java", "-jar", "/app/app.jar"]
